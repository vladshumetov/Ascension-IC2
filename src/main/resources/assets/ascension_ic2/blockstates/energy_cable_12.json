{
    "multipart":  [
                      {
                          "apply":  {
                                        "model":  "ascension_ic2:block/cable/energy_core"
                                    }
                      },
                      {
                          "when":  {
                                       "north":  "true"
                                   },
                          "apply":  {
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "uvlock":  true
                                    }
                      },
                      {
                          "when":  {
                                       "east":  "true"
                                   },
                          "apply":  {
                                        "uvlock":  true,
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "y":  90
                                    }
                      },
                      {
                          "when":  {
                                       "south":  "true"
                                   },
                          "apply":  {
                                        "uvlock":  true,
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "y":  180
                                    }
                      },
                      {
                          "when":  {
                                       "west":  "true"
                                   },
                          "apply":  {
                                        "uvlock":  true,
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "y":  270
                                    }
                      },
                      {
                          "when":  {
                                       "up":  "true"
                                   },
                          "apply":  {
                                        "uvlock":  true,
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "x":  -90
                                    }
                      },
                      {
                          "when":  {
                                       "down":  "true"
                                   },
                          "apply":  {
                                        "uvlock":  true,
                                        "model":  "ascension_ic2:block/cable/energy_side",
                                        "x":  90
                                    }
                      }
                  ]
}